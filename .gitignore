# --- اسرار و اطلاعات حساس ---
.env

# --- حالت زمان اجرا ---
# پوشه data/ شامل فایل سشن تلگرام (دسترسی کامل به اکانت) و logger.db
# (پیام‌های خصوصی واقعی) است. هیچ‌کدام هرگز نباید کامیت شوند.
# فقط .gitkeep نگه داشته می‌شود تا ساختار پوشه در ریپو دیده شود.
data/*

# نسخه‌های پشتیبان data/ — همان سشن و همان دیتابیس پیام‌های خصوصی داخلشان
# است، پس دقیقا به همان دلیل نباید کامیت شوند.
data.backup-*/
!data/.gitkeep

# اگر فایل سشن یا دیتابیس از نسخه‌های قدیمی در ریشه مانده باشد
*.session
*.session-journal
*.db
*.db-journal
*.db-wal
*.db-shm

# --- پایتون ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- ابزارها و ادیتورها ---
.idea/
.zed/
.vscode/
.claude/

# --- سیستم‌عامل ---
.DS_Store
Thumbs.db
