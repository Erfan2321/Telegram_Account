# ============================================================
#  Telegram UserBot — نمونه پیکربندی
#  این فایل را به .env کپی کنید و مقادیر را پر کنید:
#      cp .env.example .env
#  فقط API_ID و API_HASH الزامی‌اند؛ بقیه پیش‌فرض معقول دارند.
# ============================================================

# --- Telegram (الزامی) ---
# از https://my.telegram.org دریافت کنید.
# نبودنشان یعنی ربات با یک پیام روشن بالا نمی‌آید.
API_ID=
API_HASH=

# --- لاگ ---
# یکی از DEBUG / INFO / WARNING / ERROR. پیش‌فرض INFO.
# DEBUG لاگ‌های خود پایروگرام را هم باز می‌کند (بسیار پرحجم).
LOG_LEVEL=INFO

# --- همگام‌سازی ساعت ---
# ساعت عقب = خطای BadMsgNotification[16] و از کار افتادن سشن.
# اختلاف از NTP خوانده و فقط به تولید msg_id اعمال می‌شود (ساعت سیستم دست نمی‌خورد).
# اگر ساعت میزبان مطمئن است، false کردنش حدود ۸ ثانیه از زمان استارت کم می‌کند.
CLOCK_SYNC=true
# فاصله اندازه‌گیری دوره‌ای (ثانیه؛ حداقل ۶۰)
CLOCK_SYNC_INTERVAL=1800
# سقف انتظار برای پاسخ سرور زمان (ثانیه) — مستقیما به تاخیر استارت اضافه می‌شود
CLOCK_SYNC_TIMEOUT=5

# --- نگهبان مدیای زمان‌دار ---
# عکس/ویدیو/ویس‌هایی که با تایمر خودتخریب یا «فقط یک بار نمایش» به پی‌وی
# می‌آیند، پیش از دیده شدن دانلود و در «پیام‌های ذخیره‌شده» نگه داشته
# می‌شوند. مدیا از دید فرستنده دیده‌نشده باقی می‌ماند.
TTL_GUARD=true

# افزون بر Saved Messages، یک کپی در data/ttl_media/ هم ذخیره شود.
# پیش‌فرض خاموش: این پوشه هیچ سقف رشدی ندارد.
TTL_GUARD_LOCAL_COPY=false

# اگر ذخیره‌سازی ناموفق بود، ساختار خام مدیا هم به گزارشِ خطا در Saved
# Messages اضافه شود. این اتفاق قابل تکرار نیست — تا کسی به لاگ برسد فایل
# دیگر روی سرور نیست — پس برای ریشه‌یابی همین یک فرصت وجود دارد.
TTL_GUARD_DEBUG=false

# کپی‌های محلی بعد از چند روز پاک شوند. این پوشه قبلا هیچ سقفی نداشت و روی
# سرور کوچک به‌مرور دیسک را پر می‌کرد. پاک‌سازی موقع نوشتن فایل جدید انجام
# می‌شود، چون تنها همان موقع است که پوشه رشد می‌کند. نسخهٔ داخل Saved
# Messages دست نمی‌خورد.
TTL_MEDIA_RETENTION_DAYS=2

# --- منطقه زمانی نمایش ---
# همه ساعت‌هایی که داخل پیام‌های تلگرام نشان داده می‌شوند از این منطقه خوانده
# می‌شوند. کانتینر روی UTC است، پس بدون این تنظیم پیامی که ساعت ۲۱:۳۰ فرستاده
# شده ۱۸:۰۰ گزارش می‌شد. نام‌ها استاندارد IANA هستند (Asia/Tehran، Europe/Berlin…).
DISPLAY_TIMEZONE=Asia/Tehran

# --- کش مدیای گزارش حذف ---
# گزارشِ حذف، فایل پاک‌شده را از روی شناسه‌اش دوباره می‌فرستد که هیچ هزینه‌ای
# موقع دریافت ندارد؛ ولی عمر آن شناسه محدود است و پیامِ صاحبش هم دیگر نیست که
# تازه‌اش کنیم. برای همین مدیای کوچک موقع رسیدن در data/deleted_media/ کپی
# می‌شود. استیکرها و مدیای تایمردار دانلود نمی‌شوند (اولی نیازی ندارد، دومی
# را نگهبان TTL برداشته).
DELETE_CACHE_MEDIA=true

# سقف حجم هر فایل برای این کپی (مگابایت)
DELETE_CACHE_MAX_MB=5

# سقف کل پوشه (مگابایت). قدیمی‌ترها اول پاک می‌شوند؛ فایل‌ها به‌هرحال بعد از
# ۱۲ ساعت — یعنی همان عمر ردیف کش — حذف می‌شوند.
DELETE_CACHE_TOTAL_MB=500

# --- مدیریت سراسری اعضا (.gban / .gmute) ---
# دستور .gban کاربر را در گروه‌هایی که همان لحظه عضوشان است مسدود می‌کند.
# این گزینه لایه دوم است: اگر کاربرِ لیست‌شده بعدا در یکی از گروه‌های
# تحت مدیریت پیام داد، همان‌جا هم اعمال می‌شود. خاموش کردنش یعنی gban
# فقط «در لحظه اجرا» کار کند.
GBAN_ENFORCE=true

# فاصله بین درخواست‌ها در عملیات سراسری (میلی‌ثانیه؛ حداقل ۵۰).
# کم کردن این عدد ریسک FloodWait و محدود شدن حساب را مستقیما بالا می‌برد.
GLOBAL_ACTION_DELAY_MS=350

# --- موتور هوش مصنوعی (Google Gemini API) ---
# کلیدها از https://aistudio.google.com/apikey گرفته می‌شوند.
# چند کلید را با کاما جدا کنید؛ وقتی سهمیه یکی تمام شود خودکار به بعدی
# سوییچ می‌شود.
#
# هیچ کلید پیش‌فرضی داخل کد وجود ندارد و نباید باشد. اگر اینجا خالی
# بماند، ربات سالم بالا می‌آید و فقط دستورهای هوش مصنوعی با یک پیام
# روشن رد می‌شوند؛ لاگر، آب‌وهوا، قیمت‌ها و نگهبان مدیا کلید لازم ندارند.
#
# توجه: متغیر قدیمیِ AI_API_KEY (مفرد) خوانده *نمی‌شود* — مال سرویس
# قبلی بود و فرستادنش به گوگل یعنی کلید نامعتبر.
AI_API_KEYS=

# مدل پیش‌فرض: نام مستعار (flash, flash37, lite, pro) یا آیدی کامل گوگل.
# نام مدل‌های سرویس قبلی (مثل gpt-5-mini) نادیده گرفته و لاگ می‌شود.
AI_MODEL=gemini-3.6-flash

# مدل تولید تصویر (.img) — روی پلن رایگان سهمیه ندارد
AI_IMAGE_MODEL=gemini-3.1-flash-image

# مدل و صدای تبدیل متن به گفتار (.tts). فهرست صداها: .tts voices
AI_TTS_MODEL=gemini-3.1-flash-tts-preview
AI_TTS_VOICE=Kore

# حداکثر انتظار برای هر تکه پاسخ (ثانیه؛ ۱۰ تا ۹۰۰)
AI_TIMEOUT=120

# تعداد پیام‌های نگه‌داشته‌شده در حافظه گفتگوی هر چت (۲ تا ۱۰۰)
AI_MAX_TURNS=12

# حداکثر درخواست همزمان به سرویس هوش مصنوعی (حداقل ۱)
AI_MAX_CONCURRENCY=5

# سقف حجم فایلی که از تلگرام برای مدل فرستاده می‌شود (مگابایت)
AI_MEDIA_MAX_MB=25
